{
  "name": "servfix-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "dev:adb-reverse": "adb reverse tcp:8081 tcp:8081",
    "dev:metro": "npx -y node@20 node_modules/expo/bin/cli start --dev-client --host lan --port 8081 --clear",
    "dev:metro:localhost": "npx -y node@20 node_modules/expo/bin/cli start --dev-client --host localhost --port 8081 --clear",
    "android:bundle:release": "cd android && gradlew bundleRelease",
    "android:assemble:release": "cd android && gradlew assembleRelease",
    "play:internal": "npx eas-cli build -p android --profile internal",
    "play:production": "npx eas-cli build -p android --profile production",
    "play:submit:internal": "npx eas-cli submit -p android --latest -e internal",
    "play:submit:production": "npx eas-cli submit -p android --latest -e production",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~52.0.30",
    "expo-asset": "~11.0.5",
    "expo-constants": "~16.0.2",
    "expo-device": "~6.0.2",
    "expo-notifications": "~0.28.17",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "expo-updates": "~0.27.5",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~18.3.12",
    "typescript": "^5.7.3"
  }
}
