{
  "name": "servfix-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "dev:adb-reverse": "adb reverse tcp:8081 tcp:8081",
    "dev:metro": "npx -y node@20 node_modules/expo/bin/cli start --dev-client --host lan --port 8081 --clear",
    "dev:metro:localhost": "npx -y node@20 node_modules/expo/bin/cli start --dev-client --host localhost --port 8081 --clear",
    "android:bundle:release": "cd android && gradlew bundleRelease",
    "android:assemble:release": "cd android && gradlew assembleRelease",
    "play:internal": "npx eas-cli build -p android --profile internal",
    "play:production": "npx eas-cli build -p android --profile production",
    "play:submit:internal": "npx eas-cli submit -p android --latest -e internal",
    "play:submit:production": "npx eas-cli submit -p android --latest -e production",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-config": "~55.0.9",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "babel-preset-expo": "^55.0.10",
    "expo": "^55.0.5",
    "expo-asset": "~55.0.8",
    "expo-constants": "~55.0.7",
    "expo-device": "~55.0.9",
    "expo-document-picker": "~55.0.8",
    "expo-font": "~55.0.4",
    "expo-image-picker": "~55.0.11",
    "expo-location": "~55.1.2",
    "expo-notifications": "~55.0.11",
    "expo-secure-store": "~55.0.8",
    "expo-status-bar": "~55.0.4",
    "expo-updates": "~55.0.12",
    "react": "^19.2.0",
    "react-native": "^0.83.2",
    "react-native-incall-manager": "^4.2.1",
    "react-native-maps": "1.26.20",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.10",
    "typescript": "^5.7.3"
  }
}
