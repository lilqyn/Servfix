{
  "expo": {
    "name": "Servfix",
    "slug": "servfix-mobile",
    "scheme": "servfix",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-notifications",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "android": {
      "package": "com.servfix.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "servfixgh.com",
              "pathPrefix": "/payment/verify"
            },
            {
              "scheme": "https",
              "host": "www.servfixgh.com",
              "pathPrefix": "/payment/verify"
            }
          ]
        }
      ]
    },
    "extra": {
      "eas": {
        "projectId": "2be594f8-79a6-4b62-8356-72a916895885"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2be594f8-79a6-4b62-8356-72a916895885"
    },
    "ios": {
      "icon": "./assets/icon.png"
    }
  }
}
